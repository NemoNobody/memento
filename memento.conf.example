{
  "opensearch_url": "https://127.0.0.1:9200",
  "opensearch_user": "your-user",
  "opensearch_password": "your-password",
  "insecure_skip_verify": true,
  "index_name": "memento",
  "history_limit": 20,
  "secret_guard": "reject",
  "allow_plaintext": false,
  "docs_index_name": "memento-docs",
  "docs_ttl_days": 90,
  "fetch_timeout_seconds": 30,
  "fetch_max_bytes": 2000000,
  "fetch_allow_hosts": [],
  "fetch_user_agent": "memento/fetch (+OpenSearch docs cache)",
  "fetch_proxy_url": "",
  "fetch_proxy_fallback": false,
  "fetch_allow_private": false,
  "fetch_respect_robots": false,
  "local_repo_roots": [],
  "local_repo_scan_depth": 2
}
